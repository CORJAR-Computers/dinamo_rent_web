# ============================================================================
# Dinamo Rent a Car — Variables de entorno
# ============================================================================
# Copia este archivo a .env y completa los valores.
# Para Neon: https://neon.tech  → crea un proyecto y copia las URLs.

# URL de conexión con pooling (PgBouncer) — para SvelteKit serverless/edge
# Formato Neon: postgresql://USER:PASS@HOST/DB?sslmode=require&pgbouncer=true&connect_timeout=15
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/dinamo?sslmode=require&pgbouncer=true&connect_timeout=15"

# URL directa (sin pooling) — para migraciones Prisma
# Formato Neon: postgresql://USER:PASS@HOST/DB?sslmode=require
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/dinamo?sslmode=require"

# Entorno
NODE_ENV="development"

# ============================================================================
# Place to Pay (Evertec) — Pasarela de pagos y garantías
# ============================================================================
# Solicita tus credenciales como comercio en Colombia.
# Entornos: "test" (sandbox) o "prod" (producción)
P2P_ENV="test"
P2P_LOGIN="tu-login-de-comercio"
P2P_TRAN_KEY="tu-secret-key-de-comercio"

# URL a la que la pasarela redirige al usuario tras el pago (con ?requestId=XXX&reference=YYY)
# En producción debe ser HTTPS pública
P2P_RETURN_URL="http://localhost:5174/pago/retorno"

# URL pública HTTPS donde se reciben los webhooks de notificación
# En desarrollo local usa ngrok:  ngrok http 5174  →  https://xxxx.ngrok.io/api/webhooks/placetopay
P2P_NOTIFICATION_URL="https://tu-dominio.com/api/webhooks/placetopay"