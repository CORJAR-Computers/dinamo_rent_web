+// GET /api/vehicles?category=&search=&available=
+import { json } from '@sveltejs/kit';
+import type { RequestHandler } from './$types';
+import { db } from '$lib/server/db';
+import type { VehicleCategory } from '@prisma/client';
+
+export const GET: RequestHandler = async ({ url }) => {
+  try {
+    const category = url.searchParams.get('category');
+    const search = url.searchParams.get('search');
+    const onlyAvailable = url.searchParams.get('available') !== 'false';
+
+    const where: Record<string, unknown> = {};
+    if (onlyAvailable) where.available = true;
+    if (category && category !== 'all' && category !== 'TODOS') {
+      where.category = category.toUpperCase() as VehicleCategory;
+    }
+    if (search) {
+      where.OR = [
+        { name: { contains: search, mode: 'insensitive' } },
+        { brand: { contains: search, mode: 'insensitive' } },
+      ];
+    }
+
+    const vehicles = await db.vehicle.findMany({
+      where,
+      orderBy: [{ category: 'asc' }, { pricePerDay: 'asc' }],
+    });
+
+    return json({ ok: true, vehicles, count: vehicles.length });
+  } catch (e) {
+    console.error('[api/vehicles] error:', e);
+    return json({ ok: false, error: (e as Error).message }, { status: 500 });
+  }
+};
