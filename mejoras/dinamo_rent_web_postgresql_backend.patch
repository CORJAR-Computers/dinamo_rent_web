+// GET /api/reservations/[id]  |  PUT /api/reservations/[id] (cambiar estado)
+import { json } from '@sveltejs/kit';
+import type { RequestHandler } from './$types';
+import { db } from '$lib/server/db';
+
+export const GET: RequestHandler = async ({ params }) => {
+  try {
+    const reservation = await db.reservation.findUnique({
+      where: { id: params.id },
+      include: { vehicle: true, payment: true, insuranceBlock: true },
+    });
+    if (!reservation) {
+      return json({ ok: false, error: 'Reserva no encontrada' }, { status: 404 });
+    }
+    return json({ ok: true, reservation });
+  } catch (e) {
+    return json({ ok: false, error: (e as Error).message }, { status: 500 });
+  }
+};
+
+const VALID_STATUS = ['PENDIENTE', 'CONFIRMADA', 'PAGADA', 'EN_CURSO', 'FINALIZADA', 'CANCELADA'];
+
+export const PUT: RequestHandler = async ({ params, request }) => {
+  try {
+    const { status } = await request.json();
+    if (!VALID_STATUS.includes(status)) {
+      return json({ ok: false, error: 'Estado inválido' }, { status: 400 });
+    }
+    const reservation = await db.reservation.update({
+      where: { id: params.id },
+      data: { status: status as 'PENDIENTE' | 'CONFIRMADA' | 'PAGADA' | 'EN_CURSO' | 'FINALIZADA' | 'CANCELADA' },
+    });
+    return json({ ok: true, reservation });
+  } catch (e) {
+    return json({ ok: false, error: (e as Error).message }, { status: 500 });
+  }
+};
