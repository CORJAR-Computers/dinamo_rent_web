diff --git a/prisma/schema.prisma b/prisma/schema.prisma
new file mode 100644
index 0000000..57d7e59
--- /dev/null
+++ b/prisma/schema.prisma
@@ -0,0 +1,232 @@
+// ============================================================================
+// Dinamo Rent a Car — Esquema Prisma para PostgreSQL
+// ----------------------------------------------------------------------------
+// Diseñado para:
+//   - Concurrencia sin bloqueos (MVCC de PostgreSQL)
+//   - Sincronización híbrida web <-> app de escritorio (Firebird)
+//   - Reservas online con pago con tarjeta y bloqueo de cupo de seguro
+//   - Código público de reserva: DIN-2026-XXXX
+//
+// Proveedor recomendado: Neon (PostgreSQL serverless) — tier Free suficiente
+// para empezar (0.5 GB ≈ 150k–250k reservas).
+//
+// IMPORTANTE: en producción usar `prisma migrate dev` (no `db push`).
+// ============================================================================
+
+generator client {
+  provider = "prisma-client-js"
+}
+
+datasource db {
+  provider  = "postgresql"
+  url       = env("DATABASE_URL")
+  directUrl = env("DIRECT_URL")
+}
+
+// ============================================================================
+// ENUMS (reales en PostgreSQL)
+// ============================================================================
+
+enum VehicleCategory {
+  ECONOMICO
+  SEDAN
+  SUV
+  CAMIONETA
+  VAN
+  LUJO
+  PREMIUM
+}
+
+enum Transmission {
+  AUTOMATICA
+  MECANICA
+  AUTOMATICA_4X4
+}
+
+enum FuelType {
+  GASOLINA
+  DIESEL
+  HIBRIDO
+  ELECTRICO
+}
+
+enum ReservationStatus {
+  PENDIENTE
+  CONFIRMADA
+  PAGADA
+  EN_CURSO
+  FINALIZADA
+  CANCELADA
+}
+
+enum InsurancePlan {
+  BASICO
+  TOTAL
+}
+
+enum PaymentStatus {
+  APROBADO
+  RECHAZADO
+  REEMBOLSADO
+  PENDIENTE
+}
+
+enum SyncStatus {
+  PENDING
+  SYNCED
+  FAILED
+}
+
+enum SyncEntity {
+  RESERVATION
+  VEHICLE
+  PAYMENT
+  INSURANCE_BLOCK
+}
+
+enum SyncAction {
+  CREATE
+  UPDATE
+  DELETE
+}
+
+// ============================================================================
+// MODELOS
+// ============================================================================
+
+model Vehicle {
+  id            String          @id @default(cuid())
+  name          String
+  category      VehicleCategory
+  categoryLabel String          @default("")
+  badge         String          @default("")
+  brand         String          @default("")
+  transmission  Transmission    @default(MECANICA)
+  fuelType      FuelType        @default(GASOLINA)
+  seats         Int             @default(5)
+  doors         Int             @default(4)
+  ac            Boolean         @default(true)
+  luggage       String          @default("")
+  pricePerDay   Int
+  deposit       Int             @default(1000000)
+  image         String
+  gallery       String[]        @default([])
+  features      String[]        @default([])
+  plate         String?         @unique
+  available     Boolean         @default(true)
+  createdAt     DateTime        @default(now())
+  updatedAt     DateTime        @updatedAt
+
+  reservations Reservation[]
+
+  @@index([category])
+  @@index([available])
+  @@map("vehicles")
+}
+
+model Reservation {
+  id        String  @id @default(cuid())
+  code      String  @unique
+  vehicleId String
+  vehicle   Vehicle @relation(fields: [vehicleId], references: [id])
+
+  customerName       String
+  customerLastname   String  @default("")
+  customerEmail      String
+  customerPhone      String
+  customerIdType     String  @default("CC")
+  customerIdNumber   String
+  customerLicense    String?
+  customerLicenseExp String?
+  customerHotel      String?
+
+  pickupDate     DateTime
+  returnDate     DateTime
+  pickupTime     String   @default("10:00")
+  returnTime     String   @default("10:00")
+  pickupLocation String   @default("Aeropuerto Internacional Rafael Núñez (CTG)")
+  returnLocation String   @default("Aeropuerto Internacional Rafael Núñez (CTG)")
+
+  days            Int
+  baseAmount      Int
+  extrasAmount    Int @default(0)
+  insuranceAmount Int @default(0)
+  blockingAmount  Int @default(0)
+  totalAmount     Int
+
+  status           ReservationStatus @default(PENDIENTE)
+  insurancePlan    InsurancePlan     @default(TOTAL)
+  extras           Json              @default("{}")
+  signatureDataUrl String?
+  notes            String?
+
+  synced     Boolean   @default(false)
+  syncedAt   DateTime?
+  desktopRef String?
+
+  createdAt DateTime @default(now())
+  updatedAt DateTime @updatedAt
+
+  payment        Payment?
+  insuranceBlock InsuranceBlock?
+
+  @@index([vehicleId])
+  @@index([status])
+  @@index([customerEmail])
+  @@index([pickupDate, returnDate])
+  @@index([synced])
+  @@map("reservations")
+}
+
+model Payment {
+  id            String      @id @default(cuid())
+  reservationId String      @unique
+  reservation   Reservation @relation(fields: [reservationId], references: [id])
+
+  cardHolder    String
+  cardLast4     String
+  cardBrand     String
+  amount        Int
+  status        PaymentStatus @default(APROBADO)
+  transactionId String        @unique
+  installments  Int           @default(1)
+  gateway       String        @default("SIMULADO")
+  gatewayRef    String?
+
+  createdAt DateTime @default(now())
+
+  @@map("payments")
+}
+
+model InsuranceBlock {
+  id            String        @id @default(cuid())
+  reservationId String        @unique
+  reservation   Reservation   @relation(fields: [reservationId], references: [id])
+  code          String        @unique
+  type          InsurancePlan
+  description   String
+  amount        Int
+  status        String        @default("ACTIVO")
+  releasedAt    DateTime?
+
+  createdAt DateTime @default(now())
+
+  @@map("insurance_blocks")
+}
+
+model SyncLog {
+  id        String     @id @default(cuid())
+  entity    SyncEntity
+  entityId  String
+  action    SyncAction
+  status    SyncStatus @default(PENDING)
+  message   String?
+  payload   Json?
+  createdAt DateTime   @default(now())
+  syncedAt  DateTime?
+
+  @@index([status])
+  @@index([entity, entityId])
+  @@index([createdAt])
+  @@map("sync_logs")
+}
