+// POST /api/seed — siembra la flota inicial en PostgreSQL desde fleet.ts
+import { json } from '@sveltejs/kit';
+import type { RequestHandler } from './$types';
+import { db } from '$lib/server/db';
+import { FLEET_DATABASE } from '$lib/data/fleet';
+import type { VehicleCategory, Transmission, FuelType } from '@prisma/client';
+
+const CATEGORY_MAP: Record<string, VehicleCategory> = {
+  economico: 'ECONOMICO',
+  sedan: 'SEDAN',
+  suv: 'SUV',
+  premium: 'PREMIUM',
+};
+
+const TRANS_MAP: Record<string, Transmission> = {
+  'Automático': 'AUTOMATICA',
+  'Mecánico': 'MECANICA',
+  'Automático 4x4': 'AUTOMATICA_4X4',
+};
+
+const FUEL_MAP: Record<string, FuelType> = {
+  'Gasolina': 'GASOLINA',
+  'Diésel': 'DIESEL',
+};
+
+export const POST: RequestHandler = async () => {
+  try {
+    const existing = await db.vehicle.count();
+    if (existing > 0) {
+      return json({
+        ok: true,
+        seeded: false,
+        message: 'La flota ya existe en la base de datos',
+        count: existing,
+      });
+    }
+
+    const data = FLEET_DATABASE.map((v) => ({
+      name: v.name,
+      category: CATEGORY_MAP[v.category] ?? 'ECONOMICO',
+      categoryLabel: v.categoryLabel,
+      badge: v.badge,
+      brand: v.name.split(' ')[0],
+      transmission: TRANS_MAP[v.transmission] ?? 'MECANICA',
+      fuelType: FUEL_MAP[v.fuel] ?? 'GASOLINA',
+      seats: v.passengers,
+      doors: 4,
+      ac: v.ac,
+      luggage: v.luggage,
+      pricePerDay: v.priceCOP,
+      deposit: v.depositCOP,
+      image: v.image,
+      gallery: [],
+      features: v.features,
+      plate: v.plate,
+      available: true,
+    }));
+
+    await db.vehicle.createMany({ data });
+
+    return json({
+      ok: true,
+      seeded: true,
+      count: data.length,
+      message: 'Flota sembrada correctamente en PostgreSQL',
+    });
+  } catch (e) {
+    console.error('[api/seed] error:', e);
+    return json({ ok: false, error: (e as Error).message }, { status: 500 });
+  }
+};
