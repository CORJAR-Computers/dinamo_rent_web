+// POST /api/availability — verifica disponibilidad de un vehículo en fechas
+import { json } from '@sveltejs/kit';
+import type { RequestHandler } from './$types';
+import { db } from '$lib/server/db';
+import { daysBetween } from '$lib/server/helpers';
+
+export const POST: RequestHandler = async ({ request }) => {
+  try {
+    const body = await request.json();
+    const { vehicleId, pickupDate, returnDate } = body;
+    if (!vehicleId || !pickupDate || !returnDate) {
+      return json({ ok: false, error: 'Faltan datos' }, { status: 400 });
+    }
+
+    const start = new Date(pickupDate);
+    const end = new Date(returnDate);
+    if (isNaN(start.getTime()) || isNaN(end.getTime()) || end <= start) {
+      return json({ ok: false, error: 'Fechas inválidas' }, { status: 400 });
+    }
+
+    const vehicle = await db.vehicle.findUnique({ where: { id: vehicleId } });
+    if (!vehicle) {
+      return json({ ok: false, error: 'Vehículo no encontrado' }, { status: 404 });
+    }
+
+    // Verifica choques con reservas existentes (concurrencia segura en PostgreSQL)
+    const conflict = await db.reservation.findFirst({
+      where: {
+        vehicleId,
+        status: { in: ['PENDIENTE', 'CONFIRMADA', 'PAGADA', 'EN_CURSO'] },
+        pickupDate: { lte: end },
+        returnDate: { gte: start },
+      },
+    });
+
+    const days = daysBetween(start, end);
+    return json({
+      ok: true,
+      available: !conflict,
+      vehicleId,
+      days,
+      baseAmount: vehicle.pricePerDay * days,
+      deposit: vehicle.deposit,
+    });
+  } catch (e) {
+    console.error('[api/availability] error:', e);
+    return json({ ok: false, error: (e as Error).message }, { status: 500 });
+  }
+};
