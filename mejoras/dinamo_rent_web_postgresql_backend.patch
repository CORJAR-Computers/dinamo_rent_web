+// GET /api/reservations?email=&code=  |  POST /api/reservations
+import { json } from '@sveltejs/kit';
+import type { RequestHandler } from './$types';
+import { db } from '$lib/server/db';
+import {
+  genReservationCode,
+  genBlockCode,
+  daysBetween,
+  INSURANCE_CONFIG,
+  calcExtrasAmount,
+  calcBlockingAmount,
+  type ExtrasSelection,
+} from '$lib/server/helpers';
+import type { InsurancePlan } from '@prisma/client';
+
+export const GET: RequestHandler = async ({ url }) => {
+  try {
+    const email = url.searchParams.get('email');
+    const code = url.searchParams.get('code');
+    const where: Record<string, unknown> = {};
+    if (email) where.customerEmail = email;
+    if (code) where.code = code.toUpperCase();
+
+    const reservations = await db.reservation.findMany({
+      where,
+      include: { vehicle: true, payment: true },
+      orderBy: { createdAt: 'desc' },
+      take: 50,
+    });
+
+    return json({ ok: true, reservations, count: reservations.length });
+  } catch (e) {
+    console.error('[api/reservations GET] error:', e);
+    return json({ ok: false, error: (e as Error).message }, { status: 500 });
+  }
+};
+
+export const POST: RequestHandler = async ({ request }) => {
+  try {
+    const b = await request.json();
+    const {
+      vehicleId,
+      pickupDate,
+      returnDate,
+      pickupTime = '10:00',
+      returnTime = '10:00',
+      pickupLocation,
+      returnLocation,
+      customerName,
+      customerLastname = '',
+      customerEmail,
+      customerPhone,
+      customerIdType = 'CC',
+      customerIdNumber,
+      customerLicense,
+      customerLicenseExp,
+      customerHotel,
+      insurancePlan = 'TOTAL',
+      extras = {},
+      signatureDataUrl,
+      notes,
+    } = b || {};
+
+    if (!vehicleId || !pickupDate || !returnDate || !customerName || !customerEmail || !customerPhone) {
+      return json({ ok: false, error: 'Faltan campos obligatorios' }, { status: 400 });
+    }
+
+    const vehicle = await db.vehicle.findUnique({ where: { id: vehicleId } });
+    if (!vehicle) return json({ ok: false, error: 'Vehículo no encontrado' }, { status: 404 });
+    if (!vehicle.available) return json({ ok: false, error: 'Vehículo no disponible' }, { status: 400 });
+
+    const start = new Date(pickupDate);
+    const end = new Date(returnDate);
+    if (end <= start) {
+      return json({ ok: false, error: 'La fecha de devolución debe ser mayor a la de entrega' }, { status: 400 });
+    }
+
+    // Verificación de conflicto (concurrencia segura en PostgreSQL)
+    const conflict = await db.reservation.findFirst({
+      where: {
+        vehicleId,
+        status: { in: ['PENDIENTE', 'CONFIRMADA', 'PAGADA', 'EN_CURSO'] },
+        pickupDate: { lte: end },
+        returnDate: { gte: start },
+      },
+    });
+    if (conflict) {
+      return json({ ok: false, error: 'El vehículo ya está reservado en esas fechas' }, { status: 409 });
+    }
+
+    const days = daysBetween(start, end);
+    const baseAmount = vehicle.pricePerDay * days;
+    const plan = INSURANCE_CONFIG[insurancePlan as InsurancePlan] ?? INSURANCE_CONFIG.TOTAL;
+    const insuranceAmount = plan.perDay * days;
+    const extrasAmount = calcExtrasAmount(extras as ExtrasSelection, days);
+    const blockingAmount = calcBlockingAmount(baseAmount, extrasAmount, insuranceAmount);
+    const totalAmount = baseAmount + extrasAmount + insuranceAmount;
+
+    const code = genReservationCode();
+    const depositAmount = Math.round(vehicle.deposit * plan.depositFactor);
+
+    // Transacción atómica: reserva + bloqueo + sync log
+    const reservation = await db.$transaction(async (tx) => {
+      const r = await tx.reservation.create({
+        data: {
+          code,
+          vehicleId,
+          customerName,
+          customerLastname,
+          customerEmail,
+          customerPhone,
+          customerIdType,
+          customerIdNumber,
+          customerLicense,
+          customerLicenseExp,
+          customerHotel,
+          pickupDate: start,
+          returnDate: end,
+          pickupTime,
+          returnTime,
+          pickupLocation: pickupLocation ?? 'Aeropuerto Internacional Rafael Núñez (CTG)',
+          returnLocation: returnLocation ?? pickupLocation ?? 'Aeropuerto Internacional Rafael Núñez (CTG)',
+          days,
+          baseAmount,
+          extrasAmount,
+          insuranceAmount,
+          blockingAmount,
+          totalAmount,
+          status: 'PENDIENTE',
+          insurancePlan: insurancePlan as InsurancePlan,
+          extras: extras,
+          signatureDataUrl,
+          notes,
+        },
+        include: { vehicle: true },
+      });
+
+      await tx.insuranceBlock.create({
+        data: {
+          reservationId: r.id,
+          code: genBlockCode(),
+          type: insurancePlan as InsurancePlan,
+          description: `Bloqueo de cupo por ${plan.name} para reserva ${code}. Garantía: ${depositAmount} COP.`,
+          amount: blockingAmount,
+          status: 'ACTIVO',
+        },
+      });
+
+      await tx.syncLog.create({
+        data: {
+          entity: 'RESERVATION',
+          entityId: r.id,
+          action: 'CREATE',
+          status: 'PENDING',
+          message: `Reserva ${code} creada desde web, pendiente sincronizar con app de escritorio`,
+          payload: { code, vehicleId, totalAmount },
+        },
+      });
+
+      return r;
+    });
+
+    return json({ ok: true, reservation });
+  } catch (e) {
+    console.error('[api/reservations POST] error:', e);
+    return json({ ok: false, error: (e as Error).message }, { status: 500 });
+  }
+};
