+// POST /api/payments — procesa pago con tarjeta (modo SIMULADO por ahora,
+// preparado para integrar Wompi/PayU/MercadoPago después)
+import { json } from '@sveltejs/kit';
+import type { RequestHandler } from './$types';
+import { db } from '$lib/server/db';
+import { detectCardBrand, maskCard, genTxId } from '$lib/server/helpers';
+
+export const POST: RequestHandler = async ({ request }) => {
+  try {
+    const b = await request.json();
+    const {
+      reservationId,
+      cardHolder,
+      cardNumber,
+      cardExpiry,
+      cardCvc,
+      installments = 1,
+      amount,
+    } = b || {};
+
+    if (!reservationId || !cardHolder || !cardNumber || !cardExpiry || !cardCvc) {
+      return json({ ok: false, error: 'Faltan datos de la tarjeta' }, { status: 400 });
+    }
+
+    const reservation = await db.reservation.findUnique({
+      where: { id: reservationId },
+      include: { vehicle: true },
+    });
+    if (!reservation) {
+      return json({ ok: false, error: 'Reserva no encontrada' }, { status: 404 });
+    }
+    if (reservation.status === 'PAGADA') {
+      return json({ ok: false, error: 'La reserva ya está pagada' }, { status: 400 });
+    }
+
+    const digits = String(cardNumber).replace(/\s/g, '');
+    if (digits.length < 13 || digits.length > 19) {
+      return json({ ok: false, error: 'Número de tarjeta inválido' }, { status: 400 });
+    }
+    if (!/^\d{3,4}$/.test(String(cardCvc))) {
+      return json({ ok: false, error: 'CVC inválido' }, { status: 400 });
+    }
+
+    const brand = detectCardBrand(digits);
+    const last4 = maskCard(digits);
+    const tx = genTxId();
+    const payAmount = typeof amount === 'number' ? amount : reservation.totalAmount;
+
+    // Tarjeta de prueba para declinar: 4000 0000 0000 0002
+    const declined = /^4000000000/.test(digits);
+    const status = declined ? 'RECHAZADO' : 'APROBADO';
+
+    // Transacción atómica: borra pago previo si existe, crea nuevo, actualiza reserva
+    const payment = await db.$transaction(async (txn) => {
+      const existing = await txn.payment.findUnique({ where: { reservationId } }).catch(() => null);
+      if (existing) {
+        await txn.payment.delete({ where: { id: existing.id } });
+      }
+      const p = await txn.payment.create({
+        data: {
+          reservationId,
+          cardHolder,
+          cardLast4: last4,
+          cardBrand: brand,
+          amount: payAmount,
+          status: status as 'APROBADO' | 'RECHAZADO',
+          transactionId: tx,
+          installments: Number(installments) || 1,
+          gateway: 'SIMULADO',
+        },
+      });
+
+      if (status === 'APROBADO') {
+        await txn.reservation.update({
+          where: { id: reservationId },
+          data: { status: 'PAGADA' },
+        });
+        await txn.syncLog.create({
+          data: {
+            entity: 'PAYMENT',
+            entityId: p.id,
+            action: 'CREATE',
+            status: 'PENDING',
+            message: `Pago ${tx} aprobado para reserva ${reservation.code}`,
+            payload: { transactionId: tx, amount: payAmount },
+          },
+        });
+      }
+      return p;
+    });
+
+    return json({
+      ok: status === 'APROBADO',
+      status,
+      payment,
+      reservationId,
+      reservationCode: reservation.code,
+      declinedReason: declined ? 'Tarjeta de prueba declinada (modo demo)' : null,
+    });
+  } catch (e) {
+    console.error('[api/payments] error:', e);
+    return json({ ok: false, error: (e as Error).message }, { status: 500 });
+  }
+};
