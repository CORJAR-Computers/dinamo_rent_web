--- /dev/null
+++ b/src/lib/server/db.ts
@@ -0,0 +1,26 @@
+// Cliente Prisma singleton para SvelteKit (server-side only)
+// ----------------------------------------------------------------------------
+// En SvelteKit, los endpoints +server.ts corren en el servidor y pueden
+// instanciar Prisma directamente. Este singleton evita agotar conexiones
+// durante el hot-reload en desarrollo.
+
+import PrismaClient from '@prisma/client';
+import { env } from '$env/dynamic/private';
+
+const { PrismaClient: Prisma } = PrismaClient as unknown as {
+  PrismaClient: typeof import('@prisma/client').PrismaClient;
+};
+
+const globalForPrisma = globalThis as unknown as {
+  prisma?: InstanceType<typeof Prisma>;
+};
+
+export const db =
+  globalForPrisma.prisma ??
+  new Prisma({
+    log: env.NODE_ENV === 'development' ? ['warn', 'error'] : ['error'],
+  });
+
+if (env.NODE_ENV !== 'production') {
+  globalForPrisma.prisma = db;
+}
