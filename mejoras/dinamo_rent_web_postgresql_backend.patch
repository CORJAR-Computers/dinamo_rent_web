+// GET /api/sync — estado de sincronización con la app de escritorio
+// POST /api/sync — fuerza sincronización (simula el middleware Rust/Firebird)
+import { json } from '@sveltejs/kit';
+import type { RequestHandler } from './$types';
+import { db } from '$lib/server/db';
+
+export const GET: RequestHandler = async () => {
+  try {
+    const [pending, synced, failed] = await Promise.all([
+      db.syncLog.count({ where: { status: 'PENDING' } }),
+      db.syncLog.count({ where: { status: 'SYNCED' } }),
+      db.syncLog.count({ where: { status: 'FAILED' } }),
+    ]);
+    const total = pending + synced + failed;
+
+    const recent = await db.syncLog.findMany({
+      orderBy: { createdAt: 'desc' },
+      take: 8,
+    });
+
+    const [reservationsSynced, reservationsTotal] = await Promise.all([
+      db.reservation.count({ where: { synced: true } }),
+      db.reservation.count(),
+    ]);
+
+    return json({
+      ok: true,
+      desktopApp: {
+        name: 'Dinamo Rent ERP — Mostrador',
+        version: '1.4.2',
+        status: 'CONECTADO',
+        lastHeartbeat: new Date().toISOString(),
+        database: 'Firebird SQL 3.0 Embedded (local mostrador)',
+      },
+      counters: { total, pending, synced, failed, reservationsSynced, reservationsTotal },
+      recent,
+    });
+  } catch (e) {
+    return json({ ok: false, error: (e as Error).message }, { status: 500 });
+  }
+};
+
+export const POST: RequestHandler = async ({ request }) => {
+  try {
+    const b = await request.json().catch(() => ({}));
+    const { entityId, entity } = b || {};
+
+    // Sincronizar una entidad específica
+    if (entityId && entity) {
+      const log = await db.syncLog.findFirst({
+        where: { entityId, entity, status: 'PENDING' },
+        orderBy: { createdAt: 'desc' },
+      });
+      if (log) {
+        await db.syncLog.update({
+          where: { id: log.id },
+          data: { status: 'SYNCED', syncedAt: new Date() },
+        });
+      }
+      if (entity === 'RESERVATION') {
+        const desktopRef = `DESK-${Math.floor(100000 + Math.random() * 900000)}`;
+        await db.reservation.updateMany({
+          where: { id: entityId },
+          data: { synced: true, syncedAt: new Date(), desktopRef },
+        });
+        return json({ ok: true, message: 'Sincronizado con mostrador', desktopRef });
+      }
+      return json({ ok: true, message: 'Sincronizado' });
+    }
+
+    // Sincronizar todo lo pendiente
+    const pendings = await db.syncLog.findMany({ where: { status: 'PENDING' }, take: 50 });
+    let count = 0;
+    for (const p of pendings) {
+      await db.syncLog.update({
+        where: { id: p.id },
+        data: { status: 'SYNCED', syncedAt: new Date() },
+      });
+      if (p.entity === 'RESERVATION') {
+        const desktopRef = `DESK-${Math.floor(100000 + Math.random() * 900000)}`;
+        await db.reservation.updateMany({
+          where: { id: p.entityId },
+          data: { synced: true, syncedAt: new Date(), desktopRef },
+        });
+      }
+      count++;
+    }
+    return json({ ok: true, syncedCount: count, message: 'Sincronización completa' });
+  } catch (e) {
+    return json({ ok: false, error: (e as Error).message }, { status: 500 });
+  }
+};
