{
  "name": "dinamo-rent-web",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "type": "module",
  "scripts": {
    "postinstall": "svelte-kit sync && prisma generate",
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "node scripts/check.mjs",
    "check:contact": "node scripts/check-contact.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate:index": "node scripts/generate-static-index.mjs",
    "prepare": "git config core.hooksPath scripts/githooks || echo [aviso] no se pudo configurar el hook de git",
    "docs:pdf": "node scripts/acta-pdf.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/adapter-auto": "^8.0.0",
    "@sveltejs/adapter-vercel": "^7.0.0",
    "@sveltejs/kit": "^3.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^26.4.1",
    "dotenv": "^18.0.10",
    "eslint": "^10.12.0",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "^17.13.0",
    "marked": "^18.3.0",
    "prisma": "^7.10.1",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.5",
    "tailwindcss": "^4.0.0",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.0.12",
    "vitest": "^5.0.4"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1"
  },
  "overrides": {
    "effect": "^3.22.5"
  },
  "allowScripts": {
    "@prisma/client": true,
    "@prisma/engines": true,
    "prisma": true
  },
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*",
    "#generated/*": "./src/generated/prisma/*"
  }
}
