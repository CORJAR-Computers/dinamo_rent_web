// ============================================================================
// Dinamo Rent a Car — Esquema Prisma para PostgreSQL (Neon Serverless)
// ============================================================================

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
  runtime      = "nodejs"
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// ENUMS
// ============================================================================

enum VehicleCategory {
  ECONOMICO
  SEDAN
  SUV
  CAMIONETA
  VAN
  LUJO
  PREMIUM
}

enum Transmission {
  AUTOMATICA
  MECANICA
  AUTOMATICA_4X4
}

enum FuelType {
  GASOLINA
  DIESEL
  HIBRIDO
  ELECTRICO
}

enum ReservationStatus {
  PENDIENTE
  CONFIRMADA
  PAGADA
  EN_CURSO
  FINALIZADA
  CANCELADA
}

enum InsurancePlan {
  BASICO
  TOTAL
}

enum PaymentStatus {
  APROBADO
  RECHAZADO
  REEMBOLSADO
  PENDIENTE
}

enum SyncStatus {
  PENDING
  SYNCED
  FAILED
}

enum SyncEntity {
  RESERVATION
  VEHICLE
  PAYMENT
  INSURANCE_BLOCK
  CUSTOMER
}

enum SyncAction {
  CREATE
  UPDATE
  DELETE
}

// ============================================================================
// MODELOS
// ============================================================================

model Customer {
  id                String   @id @default(cuid())
  docType           String   @default("CC")
  docNumber         String   @unique
  names             String
  lastnames         String   @default("")
  fullName          String   @default("")
  email             String
  phone             String
  phone2            String?
  city              String?  @default("Cartagena")
  country           String?  @default("Colombia")
  address           String?
  // Legado: ya no se captura en la web (entrega y devolución solo en la oficina).
  hotel             String?
  license           String?
  licenseExp        String?

  // Vínculo bidireccional con software de mostrador (Firebird clientes.id)
  desktopId         Int?     @unique
  syncedWithDesktop Boolean  @default(false)

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  reservations      Reservation[]

  @@index([docNumber])
  @@index([email])
  @@map("customers")
}

model Vehicle {
  id            String          @id @default(cuid())
  name          String
  category      VehicleCategory
  categoryLabel String          @default("")
  badge         String          @default("")
  brand         String          @default("")
  transmission  Transmission    @default(MECANICA)
  fuelType      FuelType        @default(GASOLINA)
  seats         Int             @default(5)
  doors         Int             @default(4)
  ac            Boolean         @default(true)
  luggage       String          @default("")
  pricePerDay   Int
  deposit       Int             @default(1000000)
  image         String
  gallery       String[]        @default([])
  features      String[]        @default([])
  plate         String?         @unique
  units         Int             @default(1)
  available     Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  reservations Reservation[]

  @@index([category])
  @@index([available])
  @@map("vehicles")
}

model Reservation {
  id        String  @id @default(cuid())
  code      String  @unique
  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id])

  // Relación con Cliente Maestro (Cero Duplicados)
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  // Snapshot histórico de datos del conductor al momento de reservar
  customerName       String
  customerLastname   String  @default("")
  customerEmail      String
  customerPhone      String
  customerIdType     String  @default("CC")
  customerIdNumber   String
  customerLicense    String?
  customerLicenseExp String?
  // Legado: snapshot de reservas anteriores; la web ya no lo envía.
  customerHotel      String?

  // Fechas y Ubicaciones
  pickupDate     DateTime
  returnDate     DateTime
  pickupTime     String   @default("10:00")
  returnTime     String   @default("10:00")
  pickupLocation String   @default("Oficina Principal — Crespo")
  returnLocation String   @default("Oficina Principal — Crespo")

  // Montos calculados
  days            Int
  baseAmount      Int
  extrasAmount    Int @default(0)
  insuranceAmount Int @default(0)
  blockingAmount  Int @default(0)
  totalAmount     Int

  // Configuración y contrato
  status           ReservationStatus @default(PENDIENTE)
  insurancePlan    InsurancePlan     @default(TOTAL)
  extras           Json              @default("{}")
  signatureDataUrl String?
  docPhotoUrl      String?           // Foto digitalizada del Documento de Identidad (Cédula/Pasaporte)
  licensePhotoUrl  String?           // Foto digitalizada de la Licencia de Conducción
  notes            String?

  // Evidencia de aceptación de los Términos y Condiciones en el checkout web:
  // versión del documento, SHA-256 del texto aceptado, fecha e IP de la aceptación.
  termsVersion    String?
  termsHash       String?
  termsAcceptedAt DateTime?
  termsAcceptedIp String?
  // Rastro de esa evidencia. `termsAcceptedBy` nulo = aceptada por el cliente en
  // el checkout; con valor = registrada manualmente por ese administrador para
  // una reserva anterior al control (y en ese caso `termsAcceptedIp` es la IP
  // del registro, no la del cliente). `termsAcceptanceNote` es su soporte.
  termsAcceptedBy     String?
  termsAcceptanceNote String?

  // Sincronización con Software de Escritorio (Mostrador)
  synced     Boolean   @default(false)
  syncedAt   DateTime?
  desktopRef String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payment        Payment?
  insuranceBlock InsuranceBlock?
  depositCharges DepositCharge[]

  @@index([customerId])
  @@index([vehicleId])
  @@index([status])
  @@index([customerEmail])
  @@index([customerIdNumber])
  @@index([pickupDate, returnDate])
  @@index([synced])
  @@map("reservations")
}

model Payment {
  id            String      @id @default(cuid())
  reservationId String      @unique
  reservation   Reservation @relation(fields: [reservationId], references: [id])

  amount        Int
  status        PaymentStatus @default(PENDIENTE)
  transactionId String?       @unique
  installments  Int           @default(1)
  gateway       String        @default("PLACETOPAY")
  gatewayRef    String?

  // Datos de tarjeta (cuando la pasarela los comparte enmascarados)
  cardHolder    String @default("")
  cardLast4     String @default("")
  cardBrand     String @default("")

  // Integración Place to Pay (Evertec)
  p2pRequestId      String?
  p2pProcessUrl     String?
  p2pSessionStatus  String?
  p2pStatusMessage  String?
  p2pOpType         String?

  // Tokenización de Tarjeta para Garantía (Place to Pay Suscripción)
  token             String?       // Token seguro emitido por Evertec
  tokenStatus       String?       // ACTIVO, UTILIZADO, EXPIRADO
  tokenValidUntil   String?       // Fecha de vencimiento informada por pasarela
  tokenFranchise    String?       // Franquicia bancaria del token

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("payments")
}

model DepositCharge {
  id               String        @id @default(cuid())
  reservationId    String
  reservation      Reservation   @relation(fields: [reservationId], references: [id])
  amount           Int
  concept          String        // DEDUCIBLE, GASOLINA, DIAS_EXTRA, MULTA, OTRO
  description      String?
  status           PaymentStatus @default(PENDIENTE)
  transactionId    String?
  p2pRequestId     String?
  p2pStatusMessage String?
  executedBy       String        @default("ADMIN")

  // Idempotencia y conciliación del cobro con token.
  // `reference` se persiste ANTES de llamar a la pasarela: si la respuesta se
  // pierde, es el único dato con el que el cargo se puede localizar en PlacetoPay.
  reference        String?       @unique
  // Cierre manual de un cobro que quedó PENDIENTE sin veredicto:
  // "EJECUTADO" (el dinero sí salió, con su autorización) o "NO_EJECUTADO".
  resolution       String?
  resolutionNote   String?
  resolvedAt       DateTime?
  // Snapshot del consentimiento que autorizó este cargo, copiado de la reserva
  // al crearlo: el cargo queda atado al documento aceptado aunque la reserva
  // se edite después.
  consentVersion   String?
  consentHash      String?

  createdAt        DateTime      @default(now())

  @@index([reservationId])
  @@index([reservationId, status])
  @@map("deposit_charges")
}

model InsuranceBlock {
  id            String        @id @default(cuid())
  reservationId String        @unique
  reservation   Reservation   @relation(fields: [reservationId], references: [id])
  code          String        @unique
  type          InsurancePlan
  description   String
  amount        Int
  status        String        @default("ACTIVO")
  releasedAt    DateTime?

  createdAt DateTime @default(now())

  @@map("insurance_blocks")
}

/// Contador de rate limiting compartido entre instancias serverless.
/// La clave es el hash de endpoint + IP; nunca se guarda la IP en claro.
model RateLimitCounter {
  key       String   @id
  endpoint  String
  count     Int      @default(1)
  resetAt   DateTime
  updatedAt DateTime @updatedAt

  @@index([resetAt])
  @@map("rate_limit_counters")
}

model SyncLog {
  id        String     @id @default(cuid())
  entity    SyncEntity
  entityId  String
  action    SyncAction
  status    SyncStatus @default(PENDING)
  message   String?
  payload   Json?
  syncedAt  DateTime?

  createdAt DateTime @default(now())

  @@index([status])
  @@index([entity, entityId])
  @@map("sync_logs")
}
